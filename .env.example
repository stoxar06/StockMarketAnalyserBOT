# Zerodha Kite Connect credentials.
# Get these from https://kite.trade (create a PAID Connect app, ~Rs 500/month).
# Copy this file to .env and fill in your real values. NEVER commit .env.
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# SAFETY: live order placement is OFF unless this is explicitly "false".
# Leave it true until paper trading has passed (see PROJECT_PLAN.md, Phase 4).
DRY_RUN=true

# Optional LLM keys — for ANALYSIS / EXPLANATIONS / RESEARCH only, NEVER trade decisions.
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional model overrides (defaults set in src/llm.ts):
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
